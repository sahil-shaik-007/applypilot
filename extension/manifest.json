{
  "manifest_version": 3,
  "name": "ApplyPilot — Save jobs & autofill applications",
  "short_name": "ApplyPilot",
  "version": "1.1.0",
  "description": "Save any job posting to the ApplyPilot desktop app, see your match score, and autofill application forms. You always click Submit.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*/*"],
  "content_scripts": [{
    "matches": ["http://localhost:5174/*", "http://localhost:8787/*", "http://localhost:8790/*", "http://127.0.0.1:8787/*"],
    "js": ["content/webapp-bridge.js"],
    "run_at": "document_start"
  }],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "ApplyPilot",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+A" }, "description": "Open ApplyPilot" },
    "save-job": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Save this job to ApplyPilot" },
    "autofill": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Autofill this application form" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" }
}
