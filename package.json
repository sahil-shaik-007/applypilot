{
  "name": "applypilot",
  "productName": "ApplyPilot",
  "version": "1.8.0",
  "description": "ApplyPilot — search every job board at once and run parallel auto-apply campaigns with the right resume for every role.",
  "author": {
    "name": "ApplyPilot",
    "email": "support@applypilot.app"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:ui": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win --x64",
    "dist:portable": "vite build && electron-builder --win portable --x64",
    "test:connectors": "node scripts/test-connectors.js",
    "license:keys": "node scripts/license-tool.js init",
    "license:issue": "node scripts/license-tool.js issue"
  },
  "build": {
    "appId": "com.applypilot.desktop",
    "productName": "ApplyPilot",
    "copyright": "Copyright © 2026 ApplyPilot",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/icon.png",
      "web/shared/package.json",
      "web/shared/vaultCrypto.js",
      "package.json",
      "!electron/**/*.map",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.d.mts",
      "!**/node_modules/**/*.d.cts",
      "!**/node_modules/**/{README,CHANGELOG,HISTORY}.md",
      "!**/node_modules/**/{test,tests,__tests__,docs,example,examples}/**",
      "!**/node_modules/pdfjs-dist/build/**",
      "!**/node_modules/pdfjs-dist/web/**",
      "!**/node_modules/pdfjs-dist/types/**",
      "!**/node_modules/pdfjs-dist/image_decoders/**",
      "!**/node_modules/pdfjs-dist/legacy/web/**",
      "!**/node_modules/pdfjs-dist/legacy/image_decoders/**",
      "!**/node_modules/pdfjs-dist/legacy/build/*.min.mjs",
      "!**/node_modules/pdfjs-dist/legacy/build/*sandbox*",
      "!**/node_modules/@napi-rs/**"
    ],
    "asarUnpack": [
      "node_modules/playwright-core/**",
      "node_modules/pdfjs-dist/**",
      "web/shared/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ApplyPilot-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ApplyPilot-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ApplyPilot",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "manifest.json",
          "background.js",
          "content/**",
          "popup/**",
          "options/**",
          "lib/**",
          "icons/**",
          "ui/**",
          "fonts/**"
        ]
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "electron-updater": "^6.8.9",
    "mammoth": "^1.13.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@fontsource/geist-pixel": "^5.3.0",
    "@fontsource/inconsolata": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2",
    "wait-on": "^9.5.1"
  },
  "homepage": "https://applypilot.app"
}
