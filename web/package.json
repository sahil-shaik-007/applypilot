{
  "name": "@applypilot/cloud",
  "private": true,
  "version": "1.0.0",
  "description": "ApplyPilot Cloud: zero-knowledge encrypted sync + job search API, and host for the PWA in client/.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/scripts/dev.js",
    "dev:server": "node server/scripts/dev.js --server-only",
    "build": "npm --prefix client run build",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "test": "node --test --test-concurrency=1 \"server/test/*.test.js\" \"shared/*.test.mjs\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0"
  }
}
